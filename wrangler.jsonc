{
	// Static-only Worker: Cloudflare serves the Astro build in dist/ directly.
	// Cache rules live in public/_headers.
	"name": "ash-hashtag-github-io",
	"compatibility_date": "2026-10-01",
	// Attaches spt.lupyd.com to the Worker on deploy (lupyd.com must be a zone on this account).
	"routes": [
		{
			"pattern": "spt.lupyd.com",
			"custom_domain": true
		}
	],
	"build": {
		"command": "pnpm build"
	},
	"assets": {
		"directory": "./dist",
		// /work/lupyd → /work/lupyd/, matching the trailing-slash links Astro emits
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "404-page"
	}
}