---
import MainHead from '../components/MainHead.astro';
import { AUTHOR } from '../lib/memo';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
}

const { title, description } = Astro.props;

const links = [
	{ label: 'index', href: '/' },
	{ label: 'work', href: '/work/' },
	{ label: 'author', href: '/about/' },
];

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<html lang="en">
	<head>
		<MainHead title={title} description={description} />
	</head>
	<body>
		<main class="memo">
			<nav class="memo-nav" aria-label="Site">
				{links.map(({ label, href }) => <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>[{label}]</a>)}
				<span class="spacer"></span>
				<a href={`mailto:${AUTHOR.email}`}>[mail]</a>
			</nav>
			<slot />
		</main>

		<script>
			import '../scripts/fx';

			document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach((link) => {
				const url = new URL(link.href, location.href);
				if ((url.protocol === 'http:' || url.protocol === 'https:') && url.origin !== location.origin) {
					link.target = '_blank';
					link.rel = 'noopener noreferrer';
				}
			});
		</script>
	</body>
</html>
