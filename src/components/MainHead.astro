---
import '../styles/global.css';
import { type Thing, site } from '../lib/schema';

interface Props {
	title?: string | undefined;
	description?: string | undefined;
	/** Path of the social card, e.g. "/og/home.jpg". */
	image?: string | undefined;
	/** JSON-LD nodes about this page, added to the site-wide graph. */
	schema?: Thing[] | undefined;
}

const {
	title = 'Sri Pranav Tene',
	description = 'Portfolio of Sri Pranav Tene',
	image = '/og/home.jpg',
	schema = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': [...site(), ...schema] }).replace(/</g, '\\u003c');
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="theme-color" content="#0b0c0a" />
<script is:inline>
	// Pick the colour scheme before first paint: the visitor's saved choice, else the system's.
	(() => {
		const system = matchMedia('(prefers-color-scheme: light)');
		const meta = document.querySelector('meta[name="theme-color"]');
		const apply = (chosen) => {
			let saved = typeof chosen === 'string' ? chosen : null;
			try {
				saved ??= localStorage.getItem('scheme');
			} catch {}
			const scheme = saved === 'light' || saved === 'dark' ? saved : system.matches ? 'light' : 'dark';
			document.documentElement.dataset.scheme = scheme;
			meta.content = scheme === 'light' ? '#f3f1e9' : '#0b0c0a';
		};
		window.applyScheme = apply;
		apply();
		system.addEventListener('change', apply);
	})();
</script>

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Sri Pranav Tene" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.ico" sizes="48x48" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/webp" href="/favicon.webp" sizes="192x192" />
<script type="application/ld+json" set:html={jsonLd} />
