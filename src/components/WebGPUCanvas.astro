<style>
  .invert-mask {
    position: absolute;
    inset: 0;
    backdrop-filter: invert(1);
    width: 100%;
    height: 100%;

    z-index: 99;

    /* mask-image: url("assets/masks/mask-2.svg"); */
    mask-repeat: no-repeat;
    mask-position: center;
    mask-size: contain;

    /* -webkit-mask-image: url("assets/masks/mask-2.svg"); */
    -webkit-mask-repeat: no-repeat;
    -webkit-mask-position: center;
    -webkit-mask-size: contain;
  }

  #masks-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    inset: 0;
    pointer-events: none;
  }

  .box {
    animation: slide linear both;
    animation-timeline: view();
    animation-range: entry 0% exit 100%;
  }

  @keyframes slide {
    from {
      transform: translate(-170%, 170%);
    }
    to {
      transform: translate(0, 0);
    }
  }

</style>

<div id="hidden-svgs"></div>
<div id="masks-container">
  <div class="invert-mask box"/>
</div>

<script>
  interface Coord {
    x: number;
    y: number;
  }

  const coord = (x: number, y: number) => ({ x, y } as Coord);

  const randInt = (max = Number.MAX_SAFE_INTEGER) =>
    Math.floor(Math.random() * max);
  const randIntRange = (min = 0, max = Number.MAX_SAFE_INTEGER) =>
    min + randInt(max - min);

  function generatePolygon(width: number, height: number) {
    // const cy = randInt(height / 3);
    const cy = 0;
    const ry = randIntRange(cy, height);
    const rx = randInt(width);

    return [
      coord(width, cy),
      coord(0, ry),
      coord(0, height),
      coord(rx, height),
    ];
  }

  function drawFilledPolygon(
    canvas: HTMLCanvasElement,
    coords: Coord[],
    color: string
  ) {
    const ctx = canvas.getContext("2d")!;

    ctx.fillStyle = color;
    ctx.beginPath();
    const coord = coords[0];
    ctx.moveTo(coord.x, coord.y);
    for (let i = 1; i < coords.length; i++) {
      const coord = coords[i];
      ctx.lineTo(coord.x, coord.y);
    }

    ctx.closePath();
    ctx.fill();
  }

  const hiddenSvgs = document.querySelector("#hidden-svgs") as HTMLElement;
  function polygonSVG(
    points: Coord[],
    width: number,
    height: number,
    maskId: string
  ) {
    const pts = points.map((p) => `${p.x},${p.y}`).join(" ");
    const svg = `
<svg xmlns="http://www.w3.org/2000/svg"
     width="${width}" height="${height}"
     viewBox="0 0 ${width} ${height}">
     <defs>
      <mask id="${maskId}" maskUnits="userSpaceOnUse">
      <rect width="100%" height="100%" fill="black"/>
      <polygon points="${pts}" fill="white" />
        </mask>
      </defs>
</svg>`.trim();

    const div = document.createElement("div");
    div.innerHTML = svg;
    const svgElement = div.firstElementChild! as SVGElement;

    hiddenSvgs.append(svgElement);

    return { delete: () => svgElement.remove() };
  }

  async function generateMaskImage(width: number, height: number) {
    const canvas = document.createElement("canvas");
    canvas.height = height;
    canvas.width = width;

    const color = "black";
    const polygon = generatePolygon(canvas.width, canvas.height);
    drawFilledPolygon(canvas, polygon, color);

    const blob: Blob = await new Promise((res, rej) =>
      canvas.toBlob((blob) => {
        if (blob != null) {
          res(blob);
        } else {
          rej("blob is null");
        }
      })
    );

    return URL.createObjectURL(blob);
  }

  async function createMaskOverlayElement(width: number, height: number) {
    const maskImageUrl = await generateMaskImage(width, height);
    // const maskId = `mask-${randInt()}`;
    // const polygon = generatePolygon(width, height);
    // polygonSVG(polygon, width, height, maskId);
    // const maskImage = `url(#${maskId})`;

    const maskImage = `url(${maskImageUrl})`;
    const el = document.querySelector(".invert-mask")! as HTMLDivElement;
    const style = el.style;
    style.maskImage = maskImage;

    return el;
  }

  const updateOverlays = async () => {
    hiddenSvgs.replaceChildren()
    const screenWidth = window.innerWidth * window.devicePixelRatio;
    const screenHeight = window.innerHeight * window.devicePixelRatio;

    const container = document.querySelector("#masks-container") as HTMLElement;

    const maxOverlays = 1;

    for (let i = 0; i < maxOverlays; i++) {
      await createMaskOverlayElement(screenWidth, screenHeight)
    }
  };

  window.addEventListener("resize", updateOverlays);

  updateOverlays();
</script>
