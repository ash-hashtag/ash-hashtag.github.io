---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
}

const { data, id } = Astro.props.project;
---

<a class="card" href={`/work/${id}`}>
	<span class="title">{data.title}</span>
	<!-- {data.githubUrl && (
		<a href={data.githubUrl} class="github-link" aria-label={`View ${data.title} on GitHub`} onclick="event.stopPropagation()">
			<Icon icon="github-logo" size="1.5rem" />
		</a>
	)} -->
	<p class="desc">{data.description}</p>
	{data.img ? <img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" /> : <span class="fallback" aria-hidden="true"><i></i><b>{data.title.slice(0, 1)}</b><i></i></span>}
</a>

<style>
	.card {
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		height: 11rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: transform .4s cubic-bezier(.2,.8,.2,1), box-shadow .4s ease, border-color .4s ease;
	}

	.card:hover,
	.card:focus-visible {
		transform: translateY(-0.65rem);
		border-color: var(--accent-regular);
		box-shadow: 0 1.5rem 4rem rgba(0, 0, 0, .35);
		outline: none;
	}

	.title {
		grid-area: 1 / 1 / 2 / 2;
		z-index: 1;
		margin: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border-radius: 0.375rem;
	}

	.github-link {
		grid-area: 1 / 2 / 2 / 3;
		z-index: 1;
		justify-self: end;
		margin: 0.5rem;
		padding: 0.5rem;
		background: var(--gray-999);
		color: var(--gray-200);
		border-radius: 0.375rem;
		transition: color var(--theme-transition);
	}

	.github-link:hover {
		color: var(--accent-regular);
	}

	.desc {
		grid-area: 2 / 1 / 3 / 3;
		z-index: 1;
		margin: 0.5rem;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		color: var(--gray-300);
		border-radius: 0.4rem;
		font-size: var(--text-sm);
		align-self: end;
	}

	img {
		grid-area: 1 / 1 / 3 / 3;
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform .65s cubic-bezier(.2,.8,.2,1), filter .4s ease;
	}

	.card:hover img,
	.card:focus-visible img { transform: scale(1.045); filter: saturate(1.12) contrast(1.04); }

	.fallback {
		grid-area: 1 / 1 / 3 / 3;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 1.25rem;
		padding: 2rem;
		background: radial-gradient(circle at 50% 50%, rgba(217, 250, 84, .16), transparent 35%), #191916;
		color: var(--accent-regular);
	}

	.fallback i { height: 1px; background: var(--gray-800); transform: scaleX(.4); transition: transform .6s cubic-bezier(.2,.8,.2,1); }
	.fallback b { font-size: clamp(4rem, 10vw, 8rem); line-height: 1; }
	.card:hover .fallback i,
	.card:focus-visible .fallback i { transform: scaleX(1); }

	@media (prefers-reduced-motion: reduce) {
		.card,
		img,
		.fallback i { transition: none; }
		.card:hover,
		.card:focus-visible,
		.card:hover img,
		.card:focus-visible img { transform: none; }
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}

		.title {
			border-radius: 0.9375rem;
		}
	}
</style>
