---
import { AUTHOR, memoDate } from '../lib/memo';

interface Props {
	/** Left column of the header block, top to bottom. */
	left: string[];
	title: string;
	docname: string;
}

const { left, title, docname } = Astro.props;
const right = [AUTHOR.short, AUTHOR.org, memoDate()];
const rows = Math.max(left.length, right.length);
---

<header>
	<div class="memo-head">
		{Array.from({ length: rows }, (_, i) => [<span>{left[i] ?? ''}</span>, <span>{right[i] ?? ''}</span>])}
	</div>
	<h1 class="memo-title">{title}</h1>
	<p class="memo-docname">{docname}</p>
</header>
