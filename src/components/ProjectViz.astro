<script>
	// The mockups' status bars show the visitor's current time, in their locale.
	const clocks = document.querySelectorAll<HTMLTimeElement>('.lp-time');
	const macClocks = document.querySelectorAll<HTMLTimeElement>('.lp-mac-time');
	if (clocks.length || macClocks.length) {
		const fmt = new Intl.DateTimeFormat(undefined, { hour: 'numeric', minute: '2-digit' });
		// macOS: "Mon 9 Nov 7:52 PM"
		const macFmt = new Intl.DateTimeFormat(undefined, { weekday: 'short', day: 'numeric', month: 'short', hour: 'numeric', minute: '2-digit' });
		const tick = () => {
			const now = new Date();
			// Android drops the AM/PM marker from the status bar
			const text = fmt
				.formatToParts(now)
				.filter((p) => p.type !== 'dayPeriod')
				.map((p) => p.value)
				.join('')
				.trim();
			clocks.forEach((c) => {
				c.textContent = text;
				c.dateTime = now.toISOString();
			});
			const macText = macFmt.format(now).replace(/,/g, '');
			macClocks.forEach((c) => {
				c.textContent = macText;
				c.dateTime = now.toISOString();
			});
			setTimeout(tick, 60_000 - (Date.now() % 60_000));
		};
		tick();
	}
</script>
