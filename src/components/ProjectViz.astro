---
import { mantisGraph } from '../lib/graphs';
// every visual sits inside a themed card or project page
import '../styles/themes.css';

interface Props {
	id: string;
	/** Taller frame for the project page header. */
	large?: boolean;
}

const { id, large = false } = Astro.props;

/** Lupyd's own screenshots from lupyd.com, each in a light and a dark capture. */
const lupydShots = {
	desktop: ['group-channel', 'dm', 'calls', 'media', 'search', 'roles'],
	mobile: ['dm', 'group-channel', 'calls', 'media'],
};

/** Teenie's still frame: a + b on 8 bits, from examples shown on teenie.lupyd.com. */
const bits = (n: number) => [...n.toString(2).padStart(8, '0')].map((d) => d === '1');
const teenieExamples = [
	[143, 30],
	[241, 33],
	[243, 254],
	[88, 125],
].map(([a, b]) => [a, b, (a + b) & 255]);
const teenieQuestion = [165, 34, (165 + 34) & 255];

/** Which script in src/scripts/viz.ts animates this project; canvases with data-net animate themselves. */
const script: Record<string, string> = {
	shine: 'shine',
	teenie: 'teenie',
	firefly: 'firefly',
	noon: 'noon',
	light: 'light',
	'postgres-with-quic': 'quic',
	'filter-rs': 'filter',
};
---

<div class:list={['viz', `viz-${id}`, { large }]} data-viz={script[id]} aria-hidden="true">
	{
		id === 'lupyd' && (
			<div class="lp">
				{(['desktop', 'mobile'] as const).map((kind) => (
					<div class={`lp-${kind}`}>
						<div class="lp-screen">
							{lupydShots[kind].map((n, i) => (
								<span class="lp-shot" style={`--i:${i}`}>
									<img class="lp-d" src={`/assets/work/lupyd/${kind}/${n}-dark.webp`} alt="" loading="lazy" />
									<img class="lp-l" src={`/assets/work/lupyd/${kind}/${n}.webp`} alt="" loading="lazy" />
								</span>
							))}
							{kind === 'desktop' && (
								<div class="lp-menubar">
									<span class="lp-menus">
										<svg class="lp-apple" viewBox="0 0 14 17" fill="currentColor">
											<path d="M11.6 9c0-2 1.6-2.9 1.7-3a3.7 3.7 0 0 0-2.9-1.6c-1.2-.1-2.4.7-3 .7s-1.6-.7-2.6-.7A3.9 3.9 0 0 0 1.5 6.4c-1.4 2.4-.4 6 1 8 .7 1 1.5 2 2.5 2s1.4-.6 2.6-.6 1.5.6 2.6.6 1.7-1 2.4-2a8 8 0 0 0 1.1-2.2A3.4 3.4 0 0 1 11.6 9zM9.6 3a3.4 3.4 0 0 0 .8-2.6 3.6 3.6 0 0 0-2.3 1.2 3.3 3.3 0 0 0-.9 2.5A3 3 0 0 0 9.6 3z" />
										</svg>
										<b>Lupyd</b>
										<span>File</span>
										<span>Edit</span>
										<span>View</span>
										<span>Window</span>
										<span>Help</span>
									</span>
									<span class="lp-tray">
										<svg viewBox="0 0 40 16" fill="currentColor">
											<path d="M1 6.5a10 10 0 0 1 14 0l-1.5 1.6a7.8 7.8 0 0 0-11 0zm3.2 3.4a5.5 5.5 0 0 1 7.6 0L8 14z" />
											<rect x="20" y="3.5" width="16" height="9" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.3" />
											<rect x="22" y="5.5" width="10" height="5" rx="0.8" />
											<rect x="36.8" y="6" width="1.6" height="4" rx="0.6" />
										</svg>
										<time class="lp-mac-time">Mon 9 Nov 12:00 PM</time>
									</span>
								</div>
							)}
							{kind === 'mobile' && (
								<div class="lp-status">
									<time class="lp-time">12:00</time>
									<svg viewBox="0 0 54 16" fill="currentColor">
										<path d="M1 7.5a11 11 0 0 1 14 0l-1.6 1.9a8.5 8.5 0 0 0-10.8 0zm3.2 3.8a6 6 0 0 1 7.6 0L8 15.8z" />
										<path d="M30 3v12H18z" />
										<rect x="35" y="3.5" width="16" height="9" rx="2.2" fill="none" stroke="currentColor" stroke-width="1.4" />
										<rect class="lp-batt" x="37" y="5.5" width="10" height="5" rx="0.8" />
										<rect x="51.8" y="6" width="1.6" height="4" rx="0.6" />
									</svg>
								</div>
							)}
						</div>
						<img class="lp-frame" src={`/assets/work/lupyd/${kind === 'desktop' ? 'macbook' : 'pixel'}.webp`} alt="" loading="lazy" />
					</div>
				))}
			</div>
		)
	}
	{
		id === 'mantis' && (
			<>
				<canvas class="viz-net" data-net={JSON.stringify(mantisGraph)} />
				<p class="viz-cap label">memory safety is checked before codegen</p>
			</>
		)
	}
	{
		id === 'infinity' && (
			<div class="inf">
				{[1, 2, 3, 4, 5, 6].map((n, i) => (
					<img src={`/assets/work/infinity/${n}.webp`} alt="" loading="lazy" style={`--i:${i}`} />
				))}
				<span class="inf-g label">
					gravity <b>↓</b>
				</span>
			</div>
		)
	}
	{
		id === 'firefly' && (
			<div class="ff">
				<div class="ff-col">
					<span class="label">alice · phone</span>
					<div class="ff-lane" data-lane="a">
						<div class="msg out">still on for friday?</div>
					</div>
				</div>
				<div class="ff-col srv">
					<span class="label">server sees</span>
					<div class="ff-lane" data-lane="s">
						<div class="msg cipher">9f2c41e0b7d38a5e12c4f0</div>
					</div>
				</div>
				<div class="ff-col">
					<span class="label">bob · laptop</span>
					<div class="ff-lane" data-lane="b">
						<div class="msg in">still on for friday?</div>
					</div>
				</div>
			</div>
		)
	}
	{
		id === 'noon' && (
			<div class="nn">
				<div class="nn-form">
					<span class="label">what should the team change?</span>
					<dl>
						<dt>name</dt>
						<dd data-f="name" class="redacted">A. Rao</dd>
						<dt>email</dt>
						<dd data-f="email" class="redacted">a.rao@corp.example</dd>
						<dt>answer</dt>
						<dd data-f="answer" class="answer">fewer meetings, longer focus blocks</dd>
					</dl>
					<div class="nn-actions">
						<span class="nn-submit" data-f="submit">submit anonymously</span>
						<span class="nn-proof on" data-f="proof">✓ eligible · unlinkable</span>
					</div>
				</div>
				<div class="nn-inbox">
					<span class="label">
						responses <b data-f="count">41</b>
					</span>
					<ol data-f="inbox">
						<li>
							<span class="mono">#041</span> <span>fewer meetings, longer focus blocks</span> <em>identity: none</em>
						</li>
					</ol>
				</div>
			</div>
		)
	}
	{
		id === 'postgres-with-quic' && (
			<div class="qr">
				<canvas />
			</div>
		)
	}
	{
		id === 'shine' && (
			<>
				<svg class="sh" viewBox="0 0 400 236" preserveAspectRatio="xMidYMid meet">
					<rect class="sh-part" x="10" y="180" width="46" height="26" rx="5" />
					<text class="sh-label" x="33" y="197" text-anchor="middle">laser</text>
					<polyline class="sh-beam" data-b="in" points="56,193 124,193" />
					<polyline class="sh-beam" data-b="arm" points="124,193 124,78 304,78" />
					<polyline class="sh-beam" data-b="arm" points="124,193 304,193 304,78" />
					<polyline class="sh-beam" data-b="a" points="304,78 360,78" />
					<polyline class="sh-beam" data-b="b" points="304,78 304,34" />
					<line class="sh-split" x1="110" y1="207" x2="138" y2="179" />
					<line class="sh-mirror" x1="110" y1="92" x2="138" y2="64" />
					<line class="sh-mirror" x1="290" y1="207" x2="318" y2="179" />
					<line class="sh-split" x1="290" y1="92" x2="318" y2="64" />
					<rect class="sh-part sh-phase" x="196" y="64" width="34" height="28" rx="5" />
					<text class="sh-phi" x="213" y="83" text-anchor="middle">φ</text>
					<text class="sh-label" x="213" y="54" text-anchor="middle" data-r="phi">φ = 2.09</text>
					<circle class="sh-det" data-d="a" cx="372" cy="78" r="12" style="--p:0.25" />
					<text class="sh-label" x="372" y="110" text-anchor="middle">det a</text>
					<text class="sh-read" x="372" y="126" text-anchor="middle" data-r="a">0.250</text>
					<circle class="sh-det" data-d="b" cx="304" cy="20" r="12" style="--p:0.75" />
					<text class="sh-label" x="326" y="17">det b</text>
					<text class="sh-read" x="326" y="31" data-r="b">0.750</text>
				</svg>
				<p class="viz-cap label">one phase shift steers the light between two detectors</p>
			</>
		)
	}
	{
		id === 'teenie' && (
			<div class="tn">
				<span class="label">examples · 4 of 999, rule hidden</span>
				<div class="tn-rows" data-f="ex">
					{teenieExamples.map(([a, b, c]) => (
						<div class="tn-row">
							<span class="tn-bits">{bits(a).map((on) => <i class:list={{ on }} />)}</span>
							<span class="tn-op">?</span>
							<span class="tn-bits">{bits(b).map((on) => <i class:list={{ on }} />)}</span>
							<span class="tn-op">→</span>
							<span class="tn-bits">{bits(c).map((on) => <i class:list={{ on }} />)}</span>
						</div>
					))}
				</div>
				<span class="tn-more">⋮ 995 more</span>
				<span class="label">
					new question · round <b data-f="round">8</b> of 8
				</span>
				<div class="tn-row tn-q">
					<span class="tn-bits" data-f="qa">{bits(teenieQuestion[0]).map((on) => <i class:list={{ on }} />)}</span>
					<span class="tn-op">?</span>
					<span class="tn-bits" data-f="qb">{bits(teenieQuestion[1]).map((on) => <i class:list={{ on }} />)}</span>
					<span class="tn-op">→</span>
					<span class="tn-bits tn-ans" data-f="ans">{bits(teenieQuestion[2]).map((on) => <i class:list={{ on }} />)}</span>
				</div>
				<p class="tn-verdict">
					<span data-f="rule">rule was a + b</span> <b data-f="ok">✓ every bit right</b>
				</p>
			</div>
		)
	}
	{
		id === 'light' && (
			<div class="lt">
				<div class="lt-peer">
					<span class="label">peer a · sync engine</span>
					<ol data-f="log-a">
						<li>→ call #40 merge(delta)</li>
					</ol>
				</div>
				<div class="lt-wire" data-f="wire">
					<span class="label lt-tag">RTCDataChannel · no server in the path</span>
				</div>
				<div class="lt-peer">
					<span class="label">peer b · handler</span>
					<ol data-f="log-b">
						<li>← handle #40</li>
					</ol>
				</div>
			</div>
		)
	}
	{
		id === 'filter-rs' && (
			<div class="tui">
				<div class="tui-bar">
					<span>filter-rs</span>
					<span>app.log</span>
					<span>
						<b data-f="hits">3</b> / <span data-f="seen">18,204</span>
					</span>
				</div>
				<ol class="tui-lines" data-f="lines">
					<li class="err">12:04:09 ERROR db error: unique constraint violated</li>
					<li class="warn">12:04:02 WARN  http timeout after 5000ms, retrying</li>
					<li>12:03:58 INFO  sync sync batch applied: 128 ops</li>
				</ol>
				<div class="tui-prompt">
					/<span data-f="query">error</span>
					<i class="caret" />
				</div>
			</div>
		)
	}
</div>

<style is:global>
	.viz {
		position: relative;
		height: 100%;
		min-height: 260px;
		padding: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.8rem;
		color: var(--ink);
		background:
			radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 0) 0 0 / 18px 18px,
			var(--bg-2);
	}
	.viz.large {
		min-height: 380px;
	}
	.viz ol {
		list-style: none;
		padding: 0;
	}
	.viz-net {
		width: 100%;
		height: calc(100% - 1.5rem);
		min-height: 220px;
	}
	.viz.large .viz-net {
		min-height: 330px;
	}
	.viz-cap {
		position: absolute;
		left: 1.25rem;
		bottom: 0.9rem;
	}

	/* firefly */
	.ff {
		display: grid;
		grid-template-columns: 1fr 1fr 1fr;
		gap: 0.75rem;
		height: 100%;
	}
	.ff-col {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		min-width: 0;
	}
	.ff-col.srv {
		padding: 0 0.6rem;
		border-inline: 1px dashed var(--line-2);
	}
	.ff-lane {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 0.45rem;
		flex: 1;
		min-height: 13rem;
		overflow: hidden;
	}
	.msg {
		max-width: 100%;
		padding: 0.45rem 0.6rem;
		border-radius: 10px;
		overflow-wrap: anywhere;
		line-height: 1.35;
		animation: msg-in 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.msg.out {
		align-self: flex-end;
		background: var(--accent);
		color: var(--accent-ink);
		border-bottom-right-radius: 3px;
	}
	.msg.in {
		align-self: flex-start;
		background: var(--panel-2);
		border: 1px solid var(--line-2);
		border-bottom-left-radius: 3px;
	}
	.msg.cipher {
		align-self: center;
		color: var(--faint);
		border: 1px dashed var(--line-2);
		letter-spacing: 0.04em;
	}
	@keyframes msg-in {
		from {
			opacity: 0;
			transform: translateY(0.5rem) scale(0.97);
		}
	}

	/* noon */
	.nn {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 1rem;
		height: 100%;
		align-items: stretch;
	}
	.nn-form,
	.nn-inbox {
		padding: 0.9rem;
		border-radius: 10px;
		background: var(--panel);
		border: 1px solid var(--line-2);
	}
	.nn dl {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.4rem 0.8rem;
		margin: 0.8rem 0;
	}
	.nn dt {
		color: var(--faint);
	}
	.nn dd {
		min-height: 1.3em;
		border-bottom: 1px solid var(--line-2);
		transition: color 0.3s;
	}
	.nn dd.redacted {
		color: transparent;
		background: repeating-linear-gradient(90deg, var(--ink) 0 0.55em, transparent 0.55em 0.62em) 0 0.2em / 100% 0.9em
			no-repeat;
		opacity: 0.85;
	}
	.nn dd.answer {
		color: var(--ink);
	}
	.nn-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}
	.nn-submit {
		padding: 0.35rem 0.6rem;
		border-radius: 6px;
		background: var(--ink);
		color: var(--bg);
		transition: transform 0.15s;
	}
	.nn-submit.press {
		transform: scale(0.94);
		background: var(--accent);
	}
	.nn-proof {
		color: var(--ok);
		opacity: 0;
		transition: opacity 0.3s;
	}
	.nn-proof.on {
		opacity: 1;
	}
	.nn-inbox b {
		color: var(--accent);
	}
	.nn-inbox ol {
		display: grid;
		gap: 0.5rem;
		margin-top: 0.8rem;
	}
	.nn-inbox li {
		display: grid;
		gap: 0.1rem;
		padding: 0.5rem 0.6rem;
		border-radius: 8px;
		background: var(--panel-2);
		animation: msg-in 0.4s ease;
	}
	.nn-inbox em {
		color: var(--ok);
		font-style: normal;
		font-size: 0.72rem;
	}

	/* quic race */
	.viz-postgres-with-quic {
		padding: 0.75rem;
	}
	.qr,
	.qr canvas {
		width: 100%;
		height: 100%;
		min-height: 250px;
	}
	.viz.large .qr canvas {
		height: 360px;
	}

	/* lupyd: the real app in a laptop and a phone, 24s per loop on each */
	.viz-lupyd {
		padding: 0;
		overflow: hidden;
	}
	.viz-lupyd.large {
		aspect-ratio: 16 / 9;
		height: auto;
	}
	.lp {
		position: absolute;
		inset: 0;
		container-type: size;
	}
	.lp-desktop,
	.lp-mobile {
		position: absolute;
		isolation: isolate;
	}
	/* a static shadow layer, not drop-shadow(): a filter re-rasters every frame the screenshots crossfade */
	.lp-desktop::before,
	.lp-mobile::before {
		content: '';
		position: absolute;
		z-index: -1;
		box-shadow: 0 18px 30px rgb(0 0 0 / 0.35);
	}
	/* insets trace the opaque part of each frame image */
	.lp-desktop::before {
		inset: 9% 8.2% 1%;
		border-radius: 2% / 3%;
	}
	.lp-mobile::before {
		inset: 2.6% 6.5%;
		border-radius: 14% / 6.8%;
	}
	/* frame proportions come from the frame images; the screen boxes are their transparent holes */
	.lp-desktop {
		left: 5cqw;
		top: 50%;
		width: min(80cqw, 125cqh);
		aspect-ratio: 4256 / 2834;
		transform: translateY(-50%);
	}
	.lp-desktop .lp-screen {
		left: 9.4%;
		top: 10.59%;
		width: 81.2%;
		height: 78.83%;
	}
	/* macOS menu bar across the laptop screen: as tall as the notch, items either side of it */
	.lp-desktop .lp-screen {
		container-type: size;
		--mb: 2.1cqw;
	}
	.lp-desktop .lp-screen img {
		top: var(--mb);
		height: calc(100% - var(--mb));
		object-fit: fill;
	}
	.lp-menubar {
		position: absolute;
		inset: 0 0 auto;
		height: var(--mb);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 1.6cqw;
		background: #000;
		color: #f2f2f4;
		font: 500 1.15cqw/1 system-ui, -apple-system, sans-serif;
		white-space: nowrap;
		z-index: 1;
	}
	:root[data-scheme='light'] .lp-menubar {
		background: #ececee;
		color: #1d1d1f;
	}
	.lp-menus,
	.lp-tray {
		display: flex;
		align-items: center;
		gap: 1.5cqw;
	}
	.lp-menus span {
		font-weight: 400;
	}
	.lp-apple {
		height: 1.3cqw;
	}
	.lp-tray svg {
		height: 1.1cqw;
	}
	.lp-mobile {
		right: 5cqw;
		bottom: 6cqh;
		height: 74cqh;
		aspect-ratio: 1620 / 3136;
	}
	.lp-mobile .lp-screen {
		left: 10.49%;
		top: 4.53%;
		width: 79.01%;
		height: 91.07%;
		border-radius: 9% / 4.2%;
	}
	/* Android status bar over the phone screenshots, showing the viewer's own clock */
	.lp-mobile .lp-screen {
		container-type: size;
		--sb: 15cqw; /* centred on the frame's punch-hole camera */
		--sb-bg: #030510;
		--sb-ink: #e8eaf0;
	}
	:root[data-scheme='light'] .lp-mobile .lp-screen {
		--sb-bg: #fff;
		--sb-ink: #1a1c22;
	}
	.lp-mobile .lp-screen img {
		top: var(--sb);
		height: calc(100% - var(--sb));
		object-fit: fill; /* the bar leaves ~4% less height; a slight squash beats cropping the header or composer */
	}
	.lp-status {
		position: absolute;
		inset: 0 0 auto;
		height: var(--sb);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 11cqw;
		background: var(--sb-bg);
		color: var(--sb-ink);
		font: 500 4.4cqw/1 system-ui, sans-serif;
		font-variant-numeric: tabular-nums;
		z-index: 1;
	}
	.lp-status svg {
		height: 4cqw;
	}
	.lp-screen {
		position: absolute;
		overflow: hidden;
		isolation: isolate; /* keep the bars' z-index under the frame, so its corners and camera stay on top */
		background: #0b0e14;
	}
	.lp-shot {
		display: contents;
	}
	/* hidden lazy images aren't fetched, so each visitor loads one capture per shot */
	:root[data-scheme='light'] .lp-d,
	:root:not([data-scheme='light']) .lp-l {
		display: none;
	}
	.lp-screen img,
	.lp-frame {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
