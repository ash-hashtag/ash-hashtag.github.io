---
import Experience from '../components/Experience.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Skyline from '../components/Skyline.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fmt, getGitHub, statsOf } from '../lib/github';
import { heroGraph } from '../lib/graphs';
import { AUTHOR, SOCIALS, getWork } from '../lib/site';

const work = await getWork();
const featured = work.slice(0, 4);
const rest = work.slice(4);

const gh = await getGitHub();
const stats = statsOf(gh);
const since = new Date(gh.since).getUTCFullYear();
const weekends = gh.days.filter((d) => [0, 6].includes(new Date(`${d.date}T00:00:00Z`).getUTCDay()));
const weekendActive = weekends.filter((d) => d.count).length;
const busyWeekends = weekendActive * 2 > weekends.length;
---

<BaseLayout
	title="Sri Pranav Tene · Founder of Lupyd · Rust, encryption & real-time systems"
	description={`Software engineer and founder building privacy-first products: Rust backends, MLS and libsignal encryption, WebRTC and QUIC transports. ${fmt(stats.total)} GitHub contributions in the last year.`}
	image="/og/home.png"
>
	<main>
		<section class="hero">
			<div class="wrap hero-grid">
				<div class="hero-copy">
					<p class="label hero-kicker">Founder &amp; engineer · Lupyd · {AUTHOR.city}</p>
					<h1>I build private, real-time software <span>from the wire protocol up.</span></h1>
					<p class="lede">
						Rust backends, end-to-end encryption with MLS and libsignal, WebRTC and QUIC transports, and the React,
						Tauri and Flutter apps on top, with C/C++, WebAssembly and <a href="/work/infinity/">Godot games</a> along
						the way. Right now I'm building <a href="/work/lupyd/">Lupyd</a>, an end-to-end encrypted collaboration
						platform.
					</p>
					<div class="cta">
						<a class="btn primary" href="#work">See the work ↓</a>
						<a class="btn" href={`mailto:${AUTHOR.email}`}>Email me</a>
						{SOCIALS.slice(0, 2).map((s) => <a class="btn" href={s.href}>{s.label} ↗</a>)}
					</div>
					<dl class="hero-stats">
						<div><dt>{fmt(stats.total)}</dt><dd class="label">contributions / yr</dd></div>
						<div><dt>{stats.activeDays}</dt><dd class="label">active days</dd></div>
						<div><dt>{gh.publicRepos}</dt><dd class="label">public repos</dd></div>
						<div><dt>{since}</dt><dd class="label">shipping since</dd></div>
					</dl>
				</div>
				<div class="hero-net">
					<canvas data-net={JSON.stringify(heroGraph)} aria-label="A routing diagram of Sri Pranav Tene's projects and the technology under them"></canvas>
					<p class="label hero-hint">hover a project · click to open it</p>
				</div>
			</div>
		</section>

		<section id="work" class="section">
			<div class="wrap">
				<div class="section-head rise">
					<h2><span class="num mono">01</span> Selected work</h2>
					<p>
						Every panel below is live: it runs the idea behind the project, not a screenshot of it. Encrypted
						messaging, anonymous forms, peer-to-peer RPC, a faster Postgres transport and the tools in between.
					</p>
				</div>
				<div class="featured">
					{featured.map((project, i) => <ProjectCard project={project} index={i} feature />)}
				</div>
				<div class="grid">
					{rest.map((project, i) => <ProjectCard project={project} index={i + featured.length} />)}
				</div>
			</div>
		</section>

		<section id="activity" class="section">
			<div class="wrap">
				<div class="section-head rise">
					<h2><span class="num mono">02</span> Shipping, every week</h2>
					<p>
						My public GitHub calendar for the last twelve months, one column per week. Pulled at build time; the
						latest pushes refresh live.
						{busyWeekends && <span class="note" style="--tilt:-2deg"> weekends too: {weekendActive} of {weekends.length}</span>}
					</p>
				</div>
				<Skyline data={gh} stats={stats} />
			</div>
		</section>

		<section id="experience" class="section">
			<div class="wrap">
				<div class="section-head rise">
					<h2><span class="num mono">03</span> Experience</h2>
					<p>Founder first, but hands on the code at every layer: protocol, server, client and the build in between.</p>
				</div>
				<Experience />
			</div>
		</section>

		<section id="contact" class="section contact">
			<div class="wrap rise">
				<p class="label">04 / contact</p>
				<h2>Have something hard to build? <span>Let's talk.</span></h2>
				<div class="contact-row">
					<a class="contact-mail" href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
					<button class="btn" type="button" data-copy={AUTHOR.email}>copy</button>
				</div>
				<div class="cta">
					{SOCIALS.map((s) => <a class="btn" href={s.href}>{s.label} ↗</a>)}
				</div>
			</div>
		</section>
	</main>
</BaseLayout>

<script>
	document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
		btn.addEventListener('click', async () => {
			try {
				await navigator.clipboard.writeText(btn.dataset.copy!);
				btn.textContent = 'copied ✓';
			} catch {
				btn.textContent = 'press ⌘/ctrl+c';
			}
			setTimeout(() => (btn.textContent = 'copy'), 1800);
		}),
	);
</script>

<style>
	.hero {
		position: relative;
		overflow: hidden;
		padding-block: clamp(3rem, 7vw, 5.5rem) clamp(3rem, 6vw, 5rem);
		background:
			radial-gradient(60rem 30rem at 85% 10%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%),
			radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 0) 0 0 / 24px 24px;
	}
	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
		gap: clamp(2rem, 4vw, 4rem);
		align-items: center;
	}
	.hero-kicker {
		color: var(--accent);
	}
	h1 {
		margin-top: 1.1rem;
		font-size: clamp(2.6rem, 5.2vw, 4.6rem);
		line-height: 0.98;
	}
	h1 span {
		color: var(--dim);
	}
	.lede {
		margin-top: 1.5rem;
		max-width: 36rem;
		font-size: clamp(1.02rem, 1.5vw, 1.18rem);
		color: var(--dim);
	}
	.lede a {
		color: var(--ink);
		text-decoration-color: var(--accent);
		text-underline-offset: 0.2em;
	}
	.cta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin-top: 2rem;
	}
	.hero-stats {
		display: grid;
		grid-template-columns: repeat(4, auto);
		justify-content: start;
		gap: 0.5rem 2.2rem;
		margin-top: 2.6rem;
		padding-top: 1.4rem;
		border-top: 1px solid var(--line);
	}
	.hero-stats dt {
		font: 700 clamp(1.6rem, 2.6vw, 2.1rem) / 1 var(--font-display);
	}
	.hero-stats dd {
		margin-top: 0.3rem;
	}
	.hero-net {
		position: relative;
		aspect-ratio: 1 / 0.92;
		border: 1px solid var(--line);
		border-radius: 20px;
		background: color-mix(in srgb, var(--panel) 70%, transparent);
	}
	.hero-net canvas {
		width: 100%;
		height: 100%;
	}
	.hero-hint {
		position: absolute;
		right: 1rem;
		bottom: 0.8rem;
		font-size: 0.62rem;
		color: var(--faint);
	}
	@media (max-width: 900px) {
		.hero-grid {
			grid-template-columns: 1fr;
		}
		.hero-net {
			aspect-ratio: 1 / 0.85;
		}
		.hero-stats {
			grid-template-columns: repeat(2, auto);
		}
	}

	.featured {
		display: grid;
		gap: 1.25rem;
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
		margin-top: 1.25rem;
	}
	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
	.section-head h2 .num {
		font-size: 0.4em;
		vertical-align: 0.9em;
		margin-right: 0.3rem;
	}
	.section-head .note {
		display: block;
		margin-top: 0.5rem;
	}

	.contact {
		background: radial-gradient(50rem 24rem at 15% 100%, color-mix(in srgb, var(--accent) 12%, transparent), transparent 70%);
	}
	.contact h2 {
		margin-top: 1rem;
		font-size: clamp(2.6rem, 7vw, 6rem);
		max-width: 14ch;
	}
	.contact h2 span {
		color: var(--accent);
	}
	.contact-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-top: 2rem;
	}
	.contact-mail {
		font: 600 clamp(1.2rem, 3.4vw, 2.2rem) / 1.1 var(--font-mono);
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-underline-offset: 0.18em;
		overflow-wrap: anywhere;
	}
</style>
