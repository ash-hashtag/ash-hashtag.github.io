---
import FormFeed from '../components/FormFeed.astro';
import MemoHeader from '../components/MemoHeader.astro';
import Sec from '../components/Sec.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { AUTHOR } from '../lib/memo';

const DOC = 'RFC 1';
const SHORT = 'The Author';

const experience = [
	{
		when: '2023 - present',
		org: 'Lupyd Media',
		role: 'Founder, full-stack developer',
		body: 'Building a privacy-focused social and collaboration platform from the ground up. Rust across the backend, React and Tauri across the clients, with MLS, blind signatures, WebSockets, WebTransport and WebRTC in the mix.',
	},
	{
		when: '2025',
		org: 'Turing',
		role: 'Rust LLM trainer, contract',
		body: 'RLHF training for Anthropic models, bringing systems-level Rust judgment into model evaluation and improvement.',
	},
	{
		when: '2022 - 2023',
		org: 'Jandas Corporation',
		role: 'Mobile application developer, contract',
		body: 'Cross-platform Flutter applications, and a low-level audio-processing product spanning Dart and C++.',
	},
	{
		when: '2021 - 2022',
		org: 'Freelance',
		role: 'Independent developer',
		body: 'Rust smart contracts, WGPU parallel-processing scripts, automation bots, games and mobile applications.',
	},
];

const toolchain = String.raw`
toolchain  = systems / realtime / product / infra

systems    = "Rust" / "C++" / "Tokio" / "Hyper" / "Axum"
             / "Boost" / "Rayon"
realtime   = "WebRTC" / "WebTransport" / "WebSockets" / "MLS"
product    = "React" / "TypeScript" / "Flutter" / "Tauri"
             / "Next.js"
infra      = "PostgreSQL" / "Redis" / "Docker" / "Kubernetes"
             / "AWS"
`.slice(1);

const ranks = String.raw`
+--------------+--------------+
| Examination  | Standing     |
+--------------+--------------+
| JEE Mains    | top 3.4%     |
| TS EAMCET    | top 0.019%   |
| TG ICET      | top 0.0055%  |
+--------------+--------------+
`.slice(1);
---

<BaseLayout
	title="Sri Pranav Tene — RFC 1: The Author"
	description="Background, experience and toolchain of Sri Pranav Tene, a software engineer building privacy-first products and real-time systems."
>
	<MemoHeader
		left={['Independent Submission', 'Request for Comments: 1', 'Updates: 0', 'Category: Informational']}
		title="The Author: Background, Experience, and Toolchain"
		docname="draft-tene-author-latest"
	/>

	<Sec id="abstract" title="Abstract">
		<p>
			This memo supplements <a href="/">RFC 0</a> with a description of its author: where the work
			has happened, what it was built with, and where the author learned to build it.
		</p>
	</Sec>

	<Sec id="background" num="1" title="Background">
		<p>
			The author moves between product thinking and low-level engineering. Good software should feel
			obvious; the engineering behind it rarely is.
		</p>
		<p>
			The interesting part is the difficult middle: turning an ambitious product idea into a system
			that stays fast, safe and understandable. That has led from encrypted social infrastructure and
			WebRTC to audio processing, GPU workloads, mobile apps and programming-language experiments.
		</p>
	</Sec>

	<Sec id="experience" num="2" title="Experience">
		<dl class="defs">
			{
				experience.map((e) => (
					<>
						<dt>
							{e.org} <span class="meta">({e.when})</span>
						</dt>
						<dd>
							<span class="meta">{e.role}.</span> {e.body}
						</dd>
					</>
				))
			}
		</dl>
	</Sec>

	<FormFeed doc={DOC} short={SHORT} />

	<Sec id="toolchain" num="3" title="Toolchain">
		<p>
			The tools in regular use are given below in ABNF [<a href="#ref-rfc5234">RFC5234</a>]. Any
			production is a valid way to start a project with the author.
		</p>
		<figure>
			<pre>{toolchain}</pre>
			<figcaption>Figure 1: Toolchain</figcaption>
		</figure>
	</Sec>

	<Sec id="education" num="4" title="Education">
		<p>
			BSc in Data Science from Kavitha Degree College, after earlier AI/ML study at Chaitanya Bharathi
			Institute of Technology. Most of the useful learning happened while making things that had to
			work.
		</p>
		<figure>
			<pre>{ranks}</pre>
			<figcaption>Table 1: Entrance examinations</figcaption>
		</figure>
	</Sec>

	<Sec id="references" num="5" title="References">
		<dl class="defs">
			<dt id="ref-rfc5234">[RFC5234]</dt>
			<dd>
				Crocker, D., Ed. and P. Overell, "Augmented BNF for Syntax Specifications: ABNF", STD 68,
				RFC 5234, January 2008, <a href="https://www.rfc-editor.org/rfc/rfc5234">&lt;https://www.rfc-editor.org/rfc/rfc5234&gt;</a>.
			</dd>
		</dl>
	</Sec>

	<Sec id="address" title="Author's Address">
		<p>
			{AUTHOR.name}<br />
			{AUTHOR.org}<br />
			{AUTHOR.city}<br />
			<br />
			Email: <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
		</p>
	</Sec>

	<FormFeed doc={DOC} short={SHORT} last />
</BaseLayout>
