---
import Experience from '../components/Experience.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { profilePage } from '../lib/schema';
import { AUTHOR } from '../lib/site';

const ranks = [
	{ value: '0.0055%', label: 'top · TG ICET' },
	{ value: '0.019%', label: 'top · TS EAMCET' },
	{ value: '3.4%', label: 'top · JEE Mains' },
];

const rules = [
	['MUST NOT', 'collect user data merely because it can be collected.'],
	['SHOULD', 'encrypt end to end. The server is not a trusted party.'],
	['SHOULD', 'remove any round trip that can be removed.'],
	['MAY', 'add a dependency when it pays rent.'],
	['MUST', 'stay understandable to whoever maintains it next.'],
];

const title = 'About · Sri Pranav Tene';
const description =
	'Sri Pranav Tene, founder of Lupyd: experience and toolkit across Rust, end-to-end encryption and real-time systems.';
---

<BaseLayout {title} {description} image="/og/about.png" schema={[profilePage('/about/', title, description)]}>
	<main>
		<section class="about-hero">
			<div class="wrap">
				<p class="label accent">About</p>
				<h1>Product instincts, <span>systems habits.</span></h1>
				<div class="about-cols">
					<p>
						I move between product thinking and low-level engineering. Good software should feel obvious; the
						engineering behind it rarely is.
					</p>
					<p>
						The interesting part is the difficult middle: turning an ambitious product idea into a system that stays
						fast, safe and understandable. That has taken me from end-to-end encrypted collaboration and WebRTC to audio
						processing in C++, GPU workloads, Godot games, a photonic circuit simulator, machine-learning research, mobile apps and a programming language of my own.
					</p>
				</div>
			</div>
		</section>

		<section class="section">
			<div class="wrap">
				<div class="section-head rise">
					<h2>Experience</h2>
					<p>Shipping since 2021; founder since 2023.</p>
				</div>
				<Experience />
			</div>
		</section>

		<section class="section">
			<div class="wrap principles">
				<div class="rise">
					<h2>How I build</h2>
					<p class="muted">
						Written the way protocol specs are, because they're meant to be just as binding. Key words per
						<a href="https://www.rfc-editor.org/rfc/rfc2119">RFC 2119</a>.
					</p>
				</div>
				<ol class="rules panel rise">
					{
						rules.map(([kw, rest], i) => (
							<li>
								<span class="mono n">{String(i + 1).padStart(2, '0')}</span>
								<p>
									Software <b class="kw">{kw}</b> {rest}
								</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="section">
			<div class="wrap edu">
				<div class="rise">
					<h2>Education</h2>
					<p class="muted">
						BSc in Data Science from Kavitha Degree College, after earlier AI/ML study at Chaitanya Bharathi
						Institute of Technology. Most of the useful learning happened while making things that had to work.
					</p>
				</div>
				<div class="ranks rise">
					{
						ranks.map((r) => (
							<div class="tile">
								<b>{r.value}</b>
								<span class="label">{r.label}</span>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<section class="section">
			<div class="wrap rise">
				<h2 class="say">Say hello: <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a></h2>
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.about-hero {
		padding-block: clamp(3.5rem, 8vw, 6.5rem);
		background: radial-gradient(circle at 1px 1px, var(--line) 1px, transparent 0) 0 0 / 24px 24px;
	}
	.accent {
		color: var(--accent);
	}
	h1 {
		margin-top: 1rem;
		font-size: clamp(3rem, 8vw, 6.5rem);
		max-width: 12ch;
	}
	h1 span {
		color: var(--dim);
	}
	.about-cols {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-top: 2.5rem;
		max-width: 60rem;
		color: var(--dim);
		font-size: 1.1rem;
	}
	.muted {
		color: var(--dim);
		margin-top: 1rem;
		max-width: 30rem;
	}
	.muted a {
		color: var(--ink);
	}
	h2 {
		font-size: clamp(2.2rem, 5vw, 3.6rem);
	}
	.principles,
	.edu {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
		gap: 2.5rem;
		align-items: start;
	}
	.rules {
		list-style: none;
		padding: 0.5rem 1.5rem;
	}
	.rules li {
		display: grid;
		grid-template-columns: 2.5rem 1fr;
		gap: 1rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--line);
		font-size: 1.1rem;
	}
	.rules li:last-child {
		border: 0;
	}
	.rules .n {
		color: var(--faint);
		padding-top: 0.2rem;
		font-size: 0.85rem;
	}
	.kw {
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.95em;
	}
	.ranks {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}
	.say {
		font-size: clamp(1.8rem, 4.5vw, 3.4rem);
	}
	.say a {
		color: var(--accent);
		overflow-wrap: anywhere;
	}
	@media (max-width: 820px) {
		.about-cols,
		.principles,
		.edu {
			grid-template-columns: 1fr;
		}
	}
	@media (max-width: 520px) {
		.ranks {
			grid-template-columns: 1fr;
		}
	}
</style>
