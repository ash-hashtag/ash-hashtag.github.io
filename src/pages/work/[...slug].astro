---
import { type CollectionEntry, render } from 'astro:content';
import FormFeed from '../../components/FormFeed.astro';
import MemoHeader from '../../components/MemoHeader.astro';
import Sec from '../../components/Sec.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AUTHOR, getWork, memoNumber } from '../../lib/memo';

interface Props {
	entry: CollectionEntry<'work'>;
	index: number;
	prev?: CollectionEntry<'work'>;
	next?: CollectionEntry<'work'>;
}

export async function getStaticPaths() {
	const work = await getWork();
	return work.map((entry, index) => ({
		params: { slug: entry.id },
		props: { entry, index, prev: work[index - 1], next: work[index + 1] },
	}));
}

const { entry, index, prev, next } = Astro.props;
const { Content } = await render(entry);
const n = memoNumber(index);
const { title, description, tags, githubUrl, url } = entry.data;
// the encrypted projects are read through their own ciphertext
const encrypted = entry.id === 'firefly' || entry.id === 'noon';
const refs = [
	url && { key: title.toUpperCase().replace(/\W+/g, '-'), href: url },
	githubUrl && { key: 'SOURCE', href: githubUrl },
].filter((r): r is { key: string; href: string } => Boolean(r));
---

<BaseLayout title={`${title} — RFC ${n}`} description={description}>
	<MemoHeader
		left={['Independent Submission', `Request for Comments: ${n}`, 'Category: Informational']}
		title={title}
		docname={`draft-tene-${entry.id}`}
	/>

	<Sec id="abstract" title="Abstract">
		<p>{description}</p>
		<p>Keywords: {tags.filter((t) => t !== 'Dev').join(', ')}</p>
	</Sec>

	<Sec id="overview" num="1" title="Overview" decrypt={encrypted}>
		<Content />
	</Sec>

	{
		refs.length > 0 && (
			<Sec id="references" num="2" title="References">
				<dl class="defs">
					{refs.map((r) => (
						<>
							<dt>[{r.key}]</dt>
							<dd><a href={r.href}>&lt;{r.href}&gt;</a></dd>
						</>
					))}
				</dl>
			</Sec>
		)
	}

	<Sec id="address" title="Author's Address">
		<p>
			{AUTHOR.name}<br />
			Email: <a href={`mailto:${AUTHOR.email}`}>{AUTHOR.email}</a>
		</p>
	</Sec>

	<nav class="siblings" aria-label="Adjacent memos">
		<span>{prev && <>&lt;- <a href={`/work/${prev.id}/`}>RFC {n - 1}: {prev.data.title}</a></>}</span>
		<span>{next && <><a href={`/work/${next.id}/`}>RFC {n + 1}: {next.data.title}</a> -&gt;</>}</span>
	</nav>

	<FormFeed doc={`RFC ${n}`} short={title} last />
</BaseLayout>

<style>
	.siblings {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 2ch;
		margin-top: 3rem;
	}
	:global(.memo .caption) {
		text-align: center;
		color: var(--dim);
		padding-left: 0 !important;
		margin-top: 0.2rem;
	}
	:global(.memo section > pre + p:not(.caption)),
	:global(.memo section > .caption + *) {
		margin-top: 1.2em;
	}
</style>
