---
import ProjectCard from '../components/ProjectCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getWork } from '../lib/site';

const work = await getWork();
---

<BaseLayout
	title="Work · Sri Pranav Tene"
	description="Projects by Sri Pranav Tene: Lupyd, Firefly, Noon, Infinity, Postgres over QUIC, Light, Filter and Mantis."
	image="/og/home.png"
>
	<main class="section" style="border-top:0">
		<div class="wrap">
			<div class="section-head rise">
				<h1>All work</h1>
				<p>Products, protocols and tools, in priority order. Each panel runs a live sketch of the idea; open one for the details.</p>
			</div>
			<div class="grid">
				{work.map((project, i) => <ProjectCard project={project} index={i} />)}
			</div>
		</div>
	</main>
</BaseLayout>

<style>
	h1 {
		font-size: clamp(2.8rem, 7vw, 5rem);
	}
	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.25rem;
	}
	@media (max-width: 860px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
