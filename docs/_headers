# Cache rules for Cloudflare (ignored by GitHub Pages).

# Rules stack, so /* sets no Cache-Control: pages keep Cloudflare's default
# (public, max-age=0, must-revalidate) and a deploy shows up immediately.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Astro's bundled JS/CSS carry a content hash in the filename.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Project images keep their names when replaced, so cache for a week and refresh quietly.
/assets/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Social cards change with the daily activity refresh.
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=604800

/sitemap*
  Cache-Control: public, max-age=3600
